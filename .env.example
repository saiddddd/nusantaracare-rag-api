# === LLM Provider: Groq ===
GROQ_API_KEY=

# Text / reasoning model (used for grounded answer synthesis)
GROQ_TEXT_MODEL=openai/gpt-oss-120b

# Vision / multimodal model (used for image captioning during ingestion
# and for answering questions that include an uploaded image)
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# === Embeddings (local, no external API needed) ===
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# === Vector database (Chroma persistent store) ===
CHROMA_PERSIST_DIR=data/index
CHROMA_COLLECTION_NAME=nusantaracare_kb

# === Retrieval tuning ===
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.35

# === App ===
APP_ENV=local
LOG_LEVEL=INFO
